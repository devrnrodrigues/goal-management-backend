					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"var baseUrl = pm.collectionVariables.get('baseUrl') || 'http://localhost:8080';",
									"var intruderEmail = 'maria.intruso@example.com';",
									"var intruderPassword = 'senhaSegura123';",
									"",
									"pm.sendRequest({",
									"    url: baseUrl + '/api/auth/login',",
									"    method: 'POST',",
									"    header: { 'Content-Type': 'application/json' },",
									"    body: { mode: 'raw', raw: JSON.stringify({ email: intruderEmail, password: intruderPassword }) }",
									"}, function (err, res) {",
									"    if (res && res.code === 200) {",
									"        pm.variables.set('intruderToken', res.json().token);",
									"    } else {",
									"        pm.sendRequest({",
									"            url: baseUrl + '/api/auth/register',",
									"            method: 'POST',",
									"            header: { 'Content-Type': 'application/json' },",
									"            body: { mode: 'raw', raw: JSON.stringify({ name: 'Maria Intruso', email: intruderEmail, password: intruderPassword }) }",
									"        }, function (errReg, resReg) {",
									"            if (resReg && resReg.code === 201) {",
									"                pm.variables.set('intruderToken', resReg.json().token);",
									"            }",
									"        });",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
